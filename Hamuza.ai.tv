/* تخصيص الأزرار ذات التأثيرات المستقبلية */
.btn-futuristic {
  background: 
    linear-gradient(45deg, 
      rgba(59, 130, 246, 0.9) 0%, 
      rgba(59, 130, 246, 0.7) 25%, 
      rgba(139, 92, 246, 0.7) 50%, 
      rgba(139, 92, 246, 0.9) 75%, 
      rgba(59, 130, 246, 0.9) 100%);
  background-size: 200% 200%;
  animation: futuristic-scan 2s linear infinite;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.2);
  box-shadow: 
    0 0 20px rgba(59, 130, 246, 0.5),
    inset 0 0 20px rgba(255,255,255,0.1);
}

.btn-futuristic::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: futuristic-glow 3s ease infinite;
}

@keyframes futuristic-scan {
  0% { background-position: 0% 0%; }
  100% { background-position: 200% 200%; }
}

@keyframes futuristic-glow {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* تخصيص البطاقات المستقبلية */
.card-futuristic {
  background: 
    linear-gradient(45deg, 
      rgba(59, 130, 246, 0.3) 0%, 
      rgba(59, 130, 246, 0.2) 25%, 
      rgba(139, 92, 246, 0.2) 50%, 
      rgba(139, 92, 246, 0.3) 75%, 
      rgba(59, 130, 246, 0.3) 100%);
  background-size: 200% 200%;
  animation: futuristic-scan 4s linear infinite;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 
    0 0 30px rgba(59, 130, 246, 0.3),
    inset 0 0 30px rgba(255,255,255,0.05);
}

.card-futuristic::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  animation: futuristic-glow 6s ease infinite;
}

/* تخصيص الأيقونات المستقبلية */
.icon-futuristic {
  background: 
    linear-gradient(45deg, 
      rgba(59, 130, 246, 0.8) 0%, 
      rgba(59, 130, 246, 0.6) 25%, 
      rgba(139, 92, 246, 0.6) 50%, 
      rgba(139, 92, 246, 0.8) 75%, 
      rgba(59, 130, 246, 0.8) 100%);
  background-size: 200% 200%;
  animation: futuristic-scan 3s linear infinite;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.3);
  box-shadow: 
    0 0 15px rgba(59, 130, 246, 0.4),
    inset 0 0 15px rgba(255,255,255,0.2);
}

.icon-futuristic::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  animation: futuristic-glow 4s ease infinite;
}

/* تخصيص النصوص المستقبلية */
.text-futuristic {
  background: 
    linear-gradient(45deg, 
      #3b82f6 0%, 
      #3b82f6 25%, 
      #8b5cf6 50%, 
      #8b5cf6 75%, 
      #3b82f6 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  position: relative;
  animation: futuristic-scan 5s linear infinite;
  text-shadow: 
    0 0 10px rgba(59, 130, 246, 0.5),
    0 0 20px rgba(59, 130, 246, 0.3);
}

.text-futuristic::before {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: futuristic-glow 7s ease infinite;
}

/* تخصيص الأزرار ذات التأثيرات السايبربانك */
.btn-cyberpunk {
  background: 
    linear-gradient(45deg, 
      #ff0080 0%, 
      #ff8c00 25%, 
      #40e0d0 50%, 
      #ff0080 75%, 
      #ff8c00 100%);
  background-size: 200% 200%;
  animation: cyberpunk-glitch 0.5s linear infinite;
  position: relative;
  overflow: hidden;
  border: 2px solid #00ffff;
  box-shadow: 
    0 0 10px #ff0080,
    0 0 20px #00ffff,
    inset 0 0 10px #ff0080;
  color: #00ffff;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.btn-cyberpunk::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.3), transparent);
  animation: cyberpunk-scan 2s linear infinite;
}

.btn-cyberpunk::after {
  content: '';
  position: absolute;
  top: -10%;
  left: -10%;
  right: -10%;
  bottom: -10%;
  background: 
    radial-gradient(circle, rgba(255, 0, 128, 0.2) 0%, transparent 50%),
    radial-gradient(circle, rgba(0, 255, 255, 0.2) 50%, transparent 100%);
  animation: cyberpunk-pulse 1s ease infinite;
  z-index: -1;
}

@keyframes cyberpunk-glitch {
  0%, 100% { background-position: 0% 0%; }
  50% { background-position: 100% 100%; }
}

@keyframes cyberpunk-scan {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100%); }
}

@keyframes cyberpunk-pulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

/* تخصيص البطاقات السايبربانك */
.card-cyberpunk {
  background: 
    linear-gradient(45deg, 
      rgba(255, 0, 128, 0.2) 0%, 
      rgba(255, 140, 0, 0.2) 25%, 
      rgba(64, 224, 208, 0.2) 50%, 
      rgba(255, 0, 128, 0.2) 75%, 
      rgba(255, 140, 0, 0.2) 100%);
  background-size: 200% 200%;
  animation: cyberpunk-glitch 1s linear infinite;
  position: relative;
  overflow: hidden;
  border: 1px solid #00ffff;
  box-shadow: 
    0 0 15px rgba(255, 0, 128, 0.5),
    0 0 25px rgba(0, 255, 255, 0.3),
    inset 0 0 15px rgba(255, 0, 128, 0.3);
}

.card-cyberpunk::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.1), transparent);
  animation: cyberpunk-scan 4s linear infinite;
}

.card-cyberpunk::after {
  content: '';
  position: absolute;
