/* تخصيص الأزرار ذات التأثيرات الكونية المتقدمة */
.btn-cosmic-advanced {
  background: 
    radial-gradient(circle at center, rgba(59, 130, 246, 0.9) 0%, transparent 70%),
    url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='50' cy='50' r='1' fill='%23ffffff' opacity='0.8'/%3E%3Ccircle cx='20' cy='20' r='0.5' fill='%23ffffff' opacity='0.6'/%3E%3Ccircle cx='80' cy='80' r='0.7' fill='%23ffffff' opacity='0.7'/%3E%3Ccircle cx='30' cy='70' r='0.3' fill='%23ffffff' opacity='0.5'/%3E%3Ccircle cx='70' cy='30' r='0.4' fill='%23ffffff' opacity='0.6'/%3E%3C/svg%3E"),
    url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cfilter id='cosmic'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.02' numOctaves='3'/%3E%3CfeDisplacementMap in='SourceGraphic' scale='2'/%3E%3C/filter%3E%3C/defs%3E%3Crect width='100' height='100' fill='%238b5cf6' filter='url(%23cosmic)' opacity='0.4'/%3E%3C/svg%3E");
  background-size: cover, 150px 150px, 100px 100px;
  animation: cosmic-advanced-rotate 15s linear infinite;
  position: relative;
  overflow: hidden;
  border: 2px solid transparent;
  box-shadow: 
    0 0 20px rgba(59, 130, 246, 0.6),
    0 0 40px rgba(139, 92, 246, 0.4),
    inset 0 0 20px rgba(59, 130, 246, 0.4);
}

.btn-cosmic-advanced::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.3) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.3) 0%, transparent 50%);
  animation: cosmic-advanced-twinkle 4s ease infinite;
}

.btn-cosmic-advanced::after {
  content: '';
  position: absolute;
  top: -10%;
  left: -10%;
  right: -10%;
  bottom: -10%;
  background: 
    conic-gradient(from 0deg, 
      rgba(59, 130, 246, 0.5) 0deg, 
      rgba(139, 92, 246, 0.5) 120deg, 
      rgba(236, 72, 153, 0.5) 240deg, 
      rgba(59, 130, 246, 0.5) 360deg);
  animation: cosmic-advanced-warp 8s linear infinite;
  z-index: -1;
}

@keyframes cosmic-advanced-rotate {
  from { background-position: 0% 0%, 0% 0%, 0% 0%; }
  to { background-position: 0% 0%, 150px 150px, 100px 100px; }
}

@keyframes cosmic-advanced-twinkle {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}

@keyframes cosmic-advanced-warp {
  from { transform: rotate(0deg) scale(1); }
  to { transform: rotate(360deg) scale(1.1); }
}

