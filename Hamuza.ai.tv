/* تخصيص الأزرار ذات التأثيرات الكونية */
.btn-cosmic {
  background: 
    radial-gradient(circle at center, rgba(59, 130, 246, 0.9) 0%, transparent 70%),
    url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='50' cy='50' r='1' fill='%23ffffff' opacity='0.5'/%3E%3Ccircle cx='20' cy='20' r='0.5' fill='%23ffffff' opacity='0.3'/%3E%3Ccircle cx='80' cy='80' r='0.7' fill='%23ffffff' opacity='0.4'/%3E%3C/svg%3E");
  background-size: cover, 200px 200px;
  animation: cosmic-rotate 10s linear infinite;
  position: relative;
  overflow: hidden;
}

.btn-cosmic::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.2) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.2) 0%, transparent 50%);
  animation: cosmic-twinkle 3s ease infinite;
}

@keyframes cosmic-rotate {
  from { background-position: 0% 0%, 0% 0%; }
  to { background-position: 0% 0%, 200px 200px; }
}

@keyframes cosmic-twinkle {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

