    linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.2), transparent);
  animation: cyberpunk-scan 3s linear infinite;
}

.icon-cyberpunk::after {
  content: '';
  position: absolute;
  top: -8%;
  left: -8%;
  right: -8%;
  bottom: -8%;
  background: 
    radial-gradient(circle, rgba(255, 0, 128, 0.3) 0%, transparent 50%),
    radial-gradient(circle, rgba(0, 255, 255, 0.3) 50%, transparent 100%);
  animation: cyberpunk-pulse 1.5s ease infinite;
  z-index: -1;
}

/* تخصيص النصوص السايبربانك */
.text-cyberpunk {
  background: 
    linear-gradient(45deg, 
      #ff0080 0%, 
      #ff8c00 25%, 
      #40e0d0 50%, 
      #ff0080 75%, 
      #ff8c00 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  position: relative;
  animation: cyberpunk-glitch 0.6s linear infinite;
  text-shadow: 
    0 0 5px #ff0080,
    0 0 10px #00ffff,
    0 0 15px #ff0080;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.text-cyberpunk::before {
  content: attr(data-text);
  position: absolute;
  top: 2px;
  left: -2px;
  right: 2px;
  bottom: -2px;
  background: 
    linear-gradient(45deg, 
      #00ffff 0%, 
      transparent 25%, 
      #ff0080 50%, 
      transparent 75%, 
      #00ffff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: cyberpunk-glitch 0.3s linear infinite;
  z-index: -1;
}

.text-cyberpunk::after {
  content: attr(data-text);
  position: absolute;
  top: -2px;
  left: 2px;
  right: -2px;
  bottom: 2px;
  background: 
    linear-gradient(45deg, 
      #ff0080 0%, 
      transparent 25%, 
      #00ffff 50%, 
      transparent 75%, 
      #ff0080 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: cyberpunk-glitch 0.4s linear infinite reverse;
  z-index: -2;
}

/* تخصيص الأزرار ذات التأثيرات النيونية المتقدمة */
.btn-neon-advanced {
  background: 
    radial-gradient(circle at 30% 20%, rgba(255, 0, 128, 0.8) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(0, 255, 255, 0.8) 0%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(255, 140, 0, 0.6) 0%, transparent 50%);
  position: relative;
  overflow: hidden;
  border: 2px solid transparent;
  box-shadow: 
    0 0 10px rgba(255, 0, 128, 0.5),
    0 0 20px rgba(0, 255, 255, 0.5),
    0 0 30px rgba(255, 140, 0, 0.5),
    inset 0 0 10px rgba(255, 0, 128, 0.3),
    inset 0 0 20px rgba(0, 255, 255, 0.3),
    inset 0 0 30px rgba(255, 140, 0, 0.3);
  animation: neon-advanced-pulse 2s ease infinite;
}

.btn-neon-advanced::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  animation: neon-advanced-scan 3s linear infinite;
}

.btn-neon-advanced::after {
  content: '';
  position: absolute;
  top: -10%;
  left: -10%;
  right: -10%;
  bottom: -10%;
  background: 
    conic-gradient(from 0deg, 
      rgba(255, 0, 128, 0.3) 0deg, 
      rgba(0, 255, 255, 0.3) 120deg, 
      rgba(255, 140, 0, 0.3) 240deg, 
      rgba(255, 0, 128, 0.3) 360deg);
  animation: neon-advanced-rotate 4s linear infinite;
  z-index: -1;
}

@keyframes neon-advanced-pulse {
  0%, 100% { 
    box-shadow: 
      0 0 10px rgba(255, 0, 128, 0.5),
      0 0 20px rgba(0, 255, 255, 0.5),
      0 0 30px rgba(255, 140, 0, 0.5),
      inset 0 0 10px rgba(255, 0, 128, 0.3),
      inset 0 0 20px rgba(0, 255, 255, 0.3),
      inset 0 0 30px rgba(255, 140, 0, 0.3);
  }
  50% { 
    box-shadow: 
      0 0 20px rgba(255, 0, 128, 0.8),
      0 0 40px rgba(0, 255, 255, 0.8),
      0 0 60px rgba(255, 140, 0, 0.8),
      inset 0 0 20px rgba(255, 0, 128, 0.5),
      inset 0 0 40px rgba(0, 255, 255, 0.5),
      inset 0 0 60px rgba(255, 140, 0, 0.5);
  }
}

@keyframes neon-advanced-scan {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100%); }
}

@keyframes neon-advanced-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

