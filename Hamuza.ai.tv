                </button>
              </div>
              
              {/* الصفحات السريعة */}
              <div className="space-y-2 mb-4">
                <div className="text-xs font-medium text-gray-400 px-2">الصفحات السريعة</div>
                {quickPages.map((page, index) => (
                  <Link 
                    key={index}
