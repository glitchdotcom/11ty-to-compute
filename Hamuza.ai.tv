    radial-gradient(circle, rgba(255, 0, 128, 0.1) 0%, transparent 50%),
    radial-gradient(circle, rgba(0, 255, 255, 0.1) 50%, transparent 100%);
  animation: cyberpunk-pulse 2s ease infinite;
  z-index: -1;
}

/* تخصيص الأيقونات السايبربانك */
.icon-cyberpunk {
  background: 
    linear-gradient(45deg, 
      rgba(255, 0, 128, 0.8) 0%, 
      rgba(255, 140, 0, 0.8) 25%, 
      rgba(64, 224, 208, 0.8) 50%, 
      rgba(255, 0, 128, 0.8) 75%, 
      rgba(255, 140, 0, 0.8) 100%);
  background-size: 200% 200%;
  animation: cyberpunk-glitch 0.8s linear infinite;
  position: relative;
  overflow: hidden;
  border: 1px solid #00ffff;
  box-shadow: 
    0 0 8px rgba(255, 0, 128, 0.6),
    0 0 16px rgba(0, 255, 255, 0.4),
    inset 0 0 8px rgba(255, 0, 128, 0.4);
}

.icon-cyberpunk::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
