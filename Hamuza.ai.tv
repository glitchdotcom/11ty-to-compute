  const quickActions = [
    { name: '📱 تطبيق الجوال', action: () => window.open('/mobile', '_blank'), icon: '📲' },
    { name: '📚 الوثائق', action: () => window.open('/docs', '_blank'), icon: '📖' },
    { name: '🐛 الإبلاغ عن خطأ', action: () => window.open('/bugs', '_blank'), icon: '🔧' },
  ];

  return (
    <>
      {/* الزر العائم */}
      <motion.button
        onClick={() => setIsOpen(!isOpen)}
        className="fixed bottom-6 left-6 z-50 w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full shadow-2xl flex items-center justify-center text-white font-bold text-xl transition-all duration-300 hover:scale-110 hover:shadow-3xl group"
        title="لوحة المطور"
        whileHover={{ scale: 1.1 }}
        whileTap={{ scale: 0.95 }}
      >
        <span className="group-hover:rotate-90 transition-transform duration-300">🛠️</span>
        
        {/* تأثير النبض */}
        <div className="absolute inset-0 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 animate-ping opacity-20"></div>
        
        {/* إشعار */}
        {notificationCount > 0 && (
          <div className="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center animate-bounce">
            {notificationCount}
          </div>
        )}
      </motion.button>

      {/* القائمة المنبثقة */}
      <AnimatePresence>
        {isOpen && (
          <>
            <motion.div 
              className="fixed bottom-28 left-6 z-50 bg-gray-800 rounded-2xl shadow-2xl p-4 w-80 border border-gray-700 backdrop-blur-sm"
              initial={{ opacity: 0, scale: 0.8, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.8, y: 20 }}
              transition={{ duration: 0.2, type: "spring" }}
            >
              {/* الهيدر */}
              <div className="flex items-center space-x-3 space-x-reverse mb-4 pb-4 border-b border-gray-700">
                <div className="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full flex items-center justify-center">
                  <span className="text-lg">🛠️</span>
                </div>
                <div className="flex-1">
                  <div className="font-bold text-white">لوحة المطور</div>
                  <div className="text-xs text-gray-400 flex items-center space-x-1">
                    <span>{environment}</span>
                    <span>•</span>
                    <span className="text-green-400">🟢 نشط</span>
                  </div>
                </div>
                <button
                  onClick={() => setIsOpen(false)}
