/* تخصيص الأزرار ذات التأثيرات السحرية */
.btn-magical {
  background: 
    linear-gradient(45deg, 
      rgba(59, 130, 246, 0.9) 0%, 
      rgba(139, 92, 246, 0.9) 25%, 
      rgba(236, 72, 153, 0.9) 50%, 
      rgba(59, 130, 246, 0.9) 75%, 
      rgba(139, 92, 246, 0.9) 100%);
  background-size: 200% 200%;
  animation: magical-sparkle 3s ease infinite;
  position: relative;
  overflow: hidden;
  border: 2px solid transparent;
  box-shadow: 
    0 0 20px rgba(59, 130, 246, 0.6),
    0 0 40px rgba(139, 92, 246, 0.4),
    0 0 60px rgba(236, 72, 153, 0.3),
    inset 0 0 20px rgba(59, 130, 246, 0.4),
    inset 0 0 40px rgba(139, 92, 246, 0.3),
    inset 0 0 60px rgba(236, 72, 153, 0.2);
}

.btn-magical::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.3) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.3) 0%, transparent 50%);
  animation: magical-glimmer 2s ease infinite;
}

.btn-magical::after {
  content: '';
  position: absolute;
  top: -10%;
  left: -10%;
  right: -10%;
  bottom: -10%;
  background: 
    conic-gradient(from 0deg, 
      rgba(255, 255, 255, 0.1) 0deg, 
      transparent 90deg, 
      rgba(255, 255, 255, 0.1) 180deg, 
      transparent 270deg, 
      rgba(255, 255, 255, 0.1) 360deg);
  animation: magical-rotate 4s linear infinite;
  z-index: -1;
}

@keyframes magical-sparkle {
  0%, 100% { 
    background-position: 0% 0%;
    filter: hue-rotate(0deg);
  }
  50% { 
    background-position: 100% 100%;
    filter: hue-rotate(180deg);
  }
}

@keyframes magical-glimmer {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

@keyframes magical-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

