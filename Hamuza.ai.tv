      rgba(236, 72, 153, 0.3) 0%, 
      transparent 50%, 
      rgba(59, 130, 246, 0.3) 100%);
  background-size: 200% 200%;
  animation: dimensional-shift 6s ease infinite;
  position: relative;
  overflow: hidden;
  transform-style: preserve-3d;
