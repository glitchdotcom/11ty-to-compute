/* تخصيص الأزرار ذات التأثيرات الزمكانية */
.btn-spacetime {
  background: 
    conic-gradient(from 0deg at 50% 50%, 
      rgba(59, 130, 246, 0.9) 0deg, 
      rgba(139, 92, 246, 0.9) 120deg, 
      rgba(236, 72, 153, 0.9) 240deg, 
      rgba(59, 130, 246, 0.9) 360deg);
  animation: spacetime-warp 4s linear infinite;
  position: relative;
  overflow: hidden;
}

.btn-spacetime::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.3) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.3) 0%, transparent 50%);
  animation: spacetime-distort 2s ease infinite;
}

@keyframes spacetime-warp {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes spacetime-distort {
  0%, 100% { 
    transform: scale(1) rotate(0deg);
  }
  50% { 
    transform: scale(1.1) rotate(180deg);
  }
}

