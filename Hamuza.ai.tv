}

// 📁 FILE: apps/web/components/Navigation.tsx
'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { motion, AnimatePresence } from 'framer-motion';
import { useApp } from '../contexts/AppContext';
import { UserMenu } from './UserMenu';

export function Navigation() {
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [isScrolled, setIsScrolled] = useState(false);
  const pathname = usePathname();
  const { user, unreadNotifications } = useApp();

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 20);
    };

    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  const navItems = [
    { name: '🏠 الرئيسية', path: '/', icon: '🏠' },
    { name: '🎬 استديو AI', path: '/ai-studio', icon: '🎬' },
    { name: '📺 المكتبة', path: '/videos', icon: '📺' },
    { name: '🔍 البحث', path: '/search', icon: '🔍' },
  ];

  const isActivePath = (path: string) => {
    if (path === '/') return pathname === '/';
    return pathname.startsWith(path);
  };

  return (
    <motion.nav 
      className={`fixed top-0 left-0 right-0 z-40 transition-all duration-300 ${
        isScrolled 
          ? 'bg-gray-900/95 backdrop-blur-md border-b border-gray-800 shadow-2xl' 
          : 'bg-transparent'
      }`}
      initial={{ y: -100 }}
      animate={{ y: 0 }}
      transition={{ duration: 0.6 }}
    >
      <div className="container mx-auto px-4">
        <div className="flex items-center justify-between h-16">
          {/* الشعار */}
          <Link 
            href="/" 
            className="flex items-center space-x-3 space-x-reverse group"
          >
            <motion.div 
              className="relative"
              whileHover={{ scale: 1.1 }}
              whileTap={{ scale: 0.95 }}
            >
              <div className="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl flex items-center justify-center shadow-lg">
                <span className="text-lg">🎬</span>
              </div>
              <div className="absolute inset-0 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl opacity-0 group-hover:opacity-20 transition-opacity"></div>
            </motion.div>
            <div className="flex flex-col">
              <span className="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
                Hamuza
              </span>
              <span className="text-xs text-gray-400 -mt-1">AI Video Platform</span>
            </div>
          </Link>

          {/* عناصر التنقل - سطح المكتب */}
          <div className="hidden md:flex items-center space-x-1 space-x-reverse">
            {navItems.map((item) => (
              <Link
                key={item.path}
                href={item.path}
                className={`relative px-4 py-2 rounded-xl transition-all duration-200 group ${
                  isActivePath(item.path)
                    ? 'text-white bg-blue-600 shadow-lg'
                    : 'text-gray-300 hover:text-white hover:bg-gray-800'
                }`}
              >
                <span className="flex items-center space-x-2 space-x-reverse">
                  <span>{item.icon}</span>
                  <span className="font-medium">{item.name}</span>
                </span>
                
                {/* تأثير التحويم */}
                {!isActivePath(item.path) && (
                  <div className="absolute inset-0 bg-gradient-to-r from-blue-500/0 to-purple-500/0 group-hover:from-blue-500/10 group-hover:to-purple-500/10 rounded-xl transition-all duration-300"></div>
                )}
              </Link>
            ))}
          </div>

          {/* جزئية المستخدم */}
          <div className="flex items-center space-x-3 space-x-reverse">
            {/* زر المعاينة للمطورين */}
            {process.env.NODE_ENV === 'development' && (
              <Link
                href="/dev-preview"
                className="hidden sm:flex items-center space-x-2 space-x-reverse px-3 py-2 bg-yellow-600 hover:bg-yellow-500 rounded-lg text-sm font-medium transition-colors shadow-lg"
              >
                <span>🛠️</span>
                <span>المعاينة</span>
              </Link>
            )}

            {/* إشعارات */}
            {user && (
              <button className="relative p-2 text-gray-400 hover:text-white transition-colors rounded-lg hover:bg-gray-800">
                <span className="text-lg">🔔</span>
                {unreadNotifications > 0 && (
                  <div className="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center animate-pulse">
                    {unreadNotifications}
                  </div>
                )}
              </button>
            )}

            {/* زر الدخول/المستخدم */}
            {user ? (
              <UserMenu user={user} />
            ) : (
              <div className="flex items-center space-x-2">
                <Link
                  href="/auth/login"
                  className="px-4 py-2 text-gray-300 hover:text-white transition-colors font-medium"
                >
                  تسجيل الدخول
                </Link>
                <Link
                  href="/auth/register"
                  className="bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 px-6 py-2 rounded-xl font-medium transition-all transform hover:scale-105 shadow-lg"
                >
                  <span className="flex items-center space-x-2">
                    <span>👤</span>
                    <span>انضم مجاناً</span>
                  </span>
                </Link>
              </div>
            )}

            {/* زر القائمة للموبايل */}
            <button
              onClick={() => setIsMenuOpen(!isMenuOpen)}
              className="md:hidden p-2 rounded-lg bg-gray-800 hover:bg-gray-700 transition-colors"
            >
              <div className="w-6 h-6 flex flex-col justify-center space-y-1">
                <motion.div 
                  className="h-0.5 bg-white"
                  animate={{ 
                    width: isMenuOpen ? '24px' : '16px',
                    rotate: isMenuOpen ? 45 : 0,
                    y: isMenuOpen ? 6 : 0 
                  }}
                ></motion.div>
                <motion.div 
                  className="h-0.5 bg-white"
                  animate={{ opacity: isMenuOpen ? 0 : 1 }}
                ></motion.div>
                <motion.div 
                  className="h-0.5 bg-white"
                  animate={{ 
                    width: isMenuOpen ? '24px' : '12px',
                    rotate: isMenuOpen ? -45 : 0,
                    y: isMenuOpen ? -6 : 0 
                  }}
                ></motion.div>
              </div>
            </button>
          </div>
        </div>

        {/* القائمة المنسدلة للموبايل */}
        <AnimatePresence>
          {isMenuOpen && (
            <motion.div
              className="md:hidden py-4 border-t border-gray-800 bg-gray-900/95 backdrop-blur-md"
              initial={{ opacity: 0, height: 0 }}
              animate={{ opacity: 1, height: 'auto' }}
              exit={{ opacity: 0, height: 0 }}
              transition={{ duration: 0.3 }}
            >
              <div className="space-y-2">
                {navItems.map((item) => (
                  <Link
                    key={item.path}
                    href={item.path}
                    onClick={() => setIsMenuOpen(false)}
                    className={`block px-4 py-3 rounded-lg transition-all ${
                      isActivePath(item.path)
                        ? 'bg-blue-600 text-white shadow-lg'
                        : 'text-gray-300 hover:text-white hover:bg-gray-800'
                    }`}
                  >
                    <span className="flex items-center space-x-3">
                      <span>{item.icon}</span>
                      <span>{item.name}</span>
                    </span>
                  </Link>
                ))}
                
                {/* رابط المعاينة في الموبايل */}
                {process.env.NODE_ENV === 'development' && (
                  <Link
                    href="/dev-preview"
                    onClick={() => setIsMenuOpen(false)}
                    className="block px-4 py-3 rounded-lg bg-yellow-600 hover:bg-yellow-500 text-white transition-colors flex items-center space-x-3"
                  >
                    <span>🛠️</span>
                    <span>معاينة المطور</span>
                  </Link>
                )}
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </motion.nav>
  );
}

// 📁 FILE: apps/web/contexts/AppContext.tsx
'use client';

import React, { createContext, useContext, useState, useEffect, ReactNode } from 'react';
import { User } from '@hamuza/shared';

interface AppContextType {
  user: User | null;
  setUser: (user: User | null) => void;
  isLoading: boolean;
  theme: 'dark' | 'light';
  setTheme: (theme: 'dark' | 'light') => void;
  language: 'ar' | 'en';
  setLanguage: (language: 'ar' | 'en') => void;
  unreadNotifications: number;
  version: string;
  environment: string;
  isMobile: boolean;
  sidebarOpen: boolean;
  setSidebarOpen: (open: boolean) => void;
}

const AppContext = createContext<AppContextType | undefined>(undefined);

export function AppProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<User | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [theme, setTheme] = useState<'dark' | 'light'>('dark');
  const [language, setLanguage] = useState<'ar' | 'en'>('ar');
  const [unreadNotifications, setUnreadNotifications] = useState(0);
  const [isMobile, setIsMobile] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useState(false);

  const version = '2.1.0';
  const environment = process.env.NODE_ENV === 'development' ? 'التطوير' : 'الإنتاج';

  useEffect(() => {
    // استعادة إعدادات المستخدم من localStorage
    const savedTheme = localStorage.getItem('hamuza-theme') as 'dark' | 'light' | null;
    const savedLanguage = localStorage.getItem('hamuza-language') as 'ar' | 'en' | null;
    
    if (savedTheme) setTheme(savedTheme);
    if (savedLanguage) setLanguage(savedLanguage);

    // كشف جهاز الجوال
    const checkMobile = () => {
      setIsMobile(window.innerWidth < 768);
    };
    
    checkMobile();
    window.addEventListener('resize', checkMobile);

    // محاكاة تحميل البيانات
    const timer = setTimeout(() => {
      setIsLoading(false);
    }, 1000);

    return () => {
      clearTimeout(timer);
      window.removeEventListener('resize', checkMobile);
    };
  }, []);

  useEffect(() => {
    // حفظ الإعدادات في localStorage
    localStorage.setItem('hamuza-theme', theme);
    localStorage.setItem('hamuza-language', language);
  }, [theme, language]);

  const value: AppContextType = {
    user,
    setUser,
    isLoading,
    theme,
    setTheme,
    language,
    setLanguage,
    unreadNotifications,
    version,
    environment,
    isMobile,
    sidebarOpen,
    setSidebarOpen,
  };

  return (
    <AppContext.Provider value={value}>
      {children}
    </AppContext.Provider>
  );
}

export function useApp() {
  const context = useContext(AppContext);
  if (context === undefined) {
    throw new Error('useApp must be used within an AppProvider');
  }
  return context;
}

// 📁 FILE: apps/web/lib/api.ts
class ApiClient {
  private baseURL: string;
  private accessToken: string | null;

  constructor() {
    this.baseURL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:3001/api';
    this.accessToken = typeof window !== 'undefined' ? localStorage.getItem('accessToken') : null;
  }

  private async request(endpoint: string, options: RequestInit = {}) {
    const url = `${this.baseURL}${endpoint}`;
    
    const headers: HeadersInit = {
      'Content-Type': 'application/json',
      ...options.headers,
    };

    if (this.accessToken) {
      headers['Authorization'] = `Bearer ${this.accessToken}`;
    }

    const config: RequestInit = {
      headers,
      ...options,
    };

    try {
      const response = await fetch(url, config);
      
      if (response.status === 401) {
        // Token expired, try to refresh
        await this.refreshToken();
        // Retry the request with new token
        return this.request(endpoint, options);
      }

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || `HTTP error! status: ${response.status}`);
      }

      return data;
    } catch (error) {
      if (error instanceof Error) {
        throw error;
      }
      throw new Error('حدث خطأ غير متوقع في الاتصال بالخادم');
    }
  }

  private async refreshToken() {
    try {
      const refreshToken = localStorage.getItem('refreshToken');
      if (!refreshToken) {
        throw new Error('No refresh token available');
      }

      const response = await fetch(`${this.baseURL}/auth/refresh`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ refreshToken }),
      });

      if (!response.ok) {
        throw new Error('Failed to refresh token');
      }

      const data = await response.json();
      this.accessToken = data.accessToken;
      localStorage.setItem('accessToken', data.accessToken);
    } catch (error) {
      // Redirect to login if refresh fails
      this.clearAuth();
      window.location.href = '/auth/login';
      throw error;
    }
  }

  private clearAuth() {
    this.accessToken = null;
    localStorage.removeItem('accessToken');
    localStorage.removeItem('refreshToken');
  }

  setAuthToken(token: string) {
    this.accessToken = token;
    localStorage.setItem('accessToken', token);
  }

  clearAuthToken() {
    this.clearAuth();
  }

  async get(endpoint: string, params?: Record<string, any>) {
    const queryString = params ? `?${new URLSearchParams(params).toString()}` : '';
    return this.request(`${endpoint}${queryString}`);
  }

  async post(endpoint: string, data?: any) {
    return this.request(endpoint, {
      method: 'POST',
      body: JSON.stringify(data),
    });
  }

  async put(endpoint: string, data?: any) {
    return this.request(endpoint, {
      method: 'PUT',
      body: JSON.stringify(data),
    });
  }

  async patch(endpoint: string, data?: any) {
    return this.request(endpoint, {
      method: 'PATCH',
      body: JSON.stringify(data),
    });
  }

  async delete(endpoint: string) {
    return this.request(endpoint, {
      method: 'DELETE',
    });
  }

  async upload(endpoint: string, formData: FormData) {
    const url = `${this.baseURL}${endpoint}`;
    
    const headers: HeadersInit = {};
    if (this.accessToken) {
      headers['Authorization'] = `Bearer ${this.accessToken}`;
    }

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers,
        body: formData,
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || `HTTP error! status: ${response.status}`);
      }

      return data;
    } catch (error) {
      if (error instanceof Error) {
        throw error;
      }
      throw new Error('حدث خطأ أثناء رفع الملف');
    }
  }
}

export const apiClient = new ApiClient();

// 📁 FILE: apps/web/app/globals.css
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --foreground-rgb: 255, 255, 255;
  --background-start-rgb: 17, 24, 39;
  --background-end-rgb: 0, 0, 0;
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: var(--font-inter), var(--font-cairo), sans-serif;
  height: 100%;
}

body {
  color: rgb(var(--foreground-rgb));
  background: linear-gradient(
      to bottom,
      transparent,
      rgb(var(--background-end-rgb))
    )
    rgb(var(--background-start-rgb));
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

/* تخصيص شريط التمرير */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #1f2937;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb {
  background: #4b5563;
  border-radius: 4px;
  transition: background 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
  background: #6b7280;
}

::-webkit-scrollbar-corner {
  background: #1f2937;
}

/* إخفاء شريط التمرير في بعض العناصر */
.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

/* تأثيرات الحركة */
@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(1deg); }
}

.float-animation {
  animation: float 6s ease-in-out infinite;
}

@keyframes gradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.gradient-text {
  background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899, #f59e0b);
  background-size: 300% 300%;
  animation: gradient 6s ease infinite;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.shimmer {
  animation: shimmer 2s infinite;
}

/* تحسينات للوضع المظلم */
@media (prefers-color-scheme: dark) {
  html {
    color-scheme: dark;
  }
}

/* تحسينات للشاشات الصغيرة */
@media (max-width: 768px) {
  .container {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}

/* تأثيرات التركيز للوصول */
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
  border-radius: 4px;
}

/* تحسينات الأداء */
* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* تحسينات للخطوط العربية */
.arabic-text {
  letter-spacing: 0;
  word-spacing: normal;
}

/* تخصيص زر السلايدر */
input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  cursor: pointer;
}

input[type="range"]:focus {
  outline: none;
}

/* تخصيص مكانة النص */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* تأثيرات الظل المحسنة */
.shadow-2xl {
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

.shadow-3xl {
  box-shadow: 0 35px 60px -15px rgba(0, 0, 0, 0.7);
}

/* تحسينات للصور */
img {
  transition: transform 0.3s ease;
}

img:hover {
  transform: scale(1.05);
}

/* تخصيص زر اللودنج */
@keyframes spin {
  to { transform: rotate(360deg); }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

/* تأثيرات الاهتزاز */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

.animate-shake {
  animation: shake 0.5s ease-in-out;
}

/* تدرجات مخصصة */
.gradient-border {
  border: 2px solid transparent;
  background: linear-gradient(45deg, #1f2937, #1f2937), 
              linear-gradient(45deg, #3b82f6, #8b5cf6);
  background-clip: padding-box, border-box;
  background-origin: padding-box, border-box;
}

/* تحسينات للشبكات */
.grid-auto-fit {
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

.grid-auto-fill {
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}

/* تأثيرات الظل النصية */
.text-shadow {
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.text-shadow-lg {
  text-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
}

/* تحسينات للوضع المظلم في المدخلات */
input, textarea, select {
  color-scheme: dark;
}

/* تخصيص زر التبديل */
.toggle-bg:after {
  content: '';
  position: absolute;
  top: 0.125rem;
  left: 0.125rem;
  background: white;
  border-radius: 50%;
  height: 1.25rem;
  width: 1.25rem;
  transition: all 0.3s ease;
}

input:checked + .toggle-bg:after {
  transform: translateX(100%);
}

input:checked + .toggle-bg {
  background: #3b82f6;
}

/* تأثيرات التحويم للبطاقات */
.card-hover {
  transition: all 0.3s ease;
}

.card-hover:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

/* تخصيص شريط التقدم */
.progress-bar {
  background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
  background-size: 200% 100%;
  animation: gradient 2s ease infinite;
}

/* تأثيرات الدخول والخروج */
.fade-enter {
  opacity: 0;
  transform: translateY(10px);
}

.fade-enter-active {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 300ms, transform 300ms;
}

.fade-exit {
  opacity: 1;
  transform: translateY(0);
}

.fade-exit-active {
  opacity: 0;
  transform: translateY(-10px);
  transition: opacity 300ms, transform 300ms;
}

/* تخصيص زر الإغلاق */
.close-button {
  transition: all 0.2s ease;
}

.close-button:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(1.1);
}

/* تحسينات للرموز التعبيرية */
.emoji {
  font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", "Android Emoji", "EmojiSymbols", "EmojiOne Mozilla", "Twemoji Mozilla", "Segoe UI Symbol", "Noto Color Emoji Compat", "emoji";
}

/* تأثيرات الخلفية */
.background-pattern {
  background-image: 
    radial-gradient(circle at 25% 25%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 75% 75%, rgba(139, 92, 246, 0.1) 0%, transparent 50%);
}

.glass-effect {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* تخصيص زر الإرسال */
.submit-button {
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  transition: all 0.3s ease;
}

.submit-button:hover:not(:disabled) {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
}

.submit-button:disabled {
  background: #6b7280;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* تخصيص العناوين */
.heading-gradient {
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  background-size: 200% auto;
  animation: gradient 3s ease infinite;
}

/* تأثيرات التنقل */
.nav-item {
  position: relative;
  overflow: hidden;
}

.nav-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  transition: width 0.3s ease;
}

.nav-item:hover::after,
.nav-item.active::after {
  width: 100%;
}

/* تخصيص الأزرار */
.btn-primary {
  @apply bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white font-medium py-2 px-4 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg;
}

.btn-secondary {
  @apply bg-gray-700 hover:bg-gray-600 text-white font-medium py-2 px-4 rounded-lg transition-all duration-300 border border-gray-600 hover:border-gray-500;
}

.btn-success {
  @apply bg-green-600 hover:bg-green-500 text-white font-medium py-2 px-4 rounded-lg transition-all duration-300;
}

.btn-danger {
  @apply bg-red-600 hover:bg-red-500 text-white font-medium py-2 px-4 rounded-lg transition-all duration-300;
}

/* تخصيص البطاقات */
.card {
  @apply bg-gray-800 rounded-xl border border-gray-700 hover:border-gray-600 transition-all duration-300;
}

.card-hover {
  @apply card transform hover:-translate-y-1 hover:shadow-xl;
}

/* تخصيص المدخلات */
.input-primary {
  @apply bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200;
}

/* تخصيص التحديد */
.select-primary {
  @apply bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent appearance-none cursor-pointer;
}

/* تخصيص النصوص */
.text-gradient {
  @apply bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent;
}

/* تأثيرات التحميل */
.skeleton {
  background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* تخصيص التنبيهات */
.alert {
  @apply p-4 rounded-lg border;
}

.alert-success {
  @apply bg-green-900/20 border-green-800 text-green-400;
}

.alert-error {
  @apply bg-red-900/20 border-red-800 text-red-400;
}

.alert-warning {
  @apply bg-yellow-900/20 border-yellow-800 text-yellow-400;
}

.alert-info {
  @apply bg-blue-900/20 border-blue-800 text-blue-400;
}

/* تحسينات للاستجابة */
@media (max-width: 640px) {
  .mobile-hidden {
    display: none;
  }
  
  .mobile-full {
    width: 100%;
  }
  
  .mobile-text-center {
    text-align: center;
  }
}

/* تخصيص شريط التقدم الدائري */
.circular-progress {
  transform: rotate(-90deg);
}

.circular-progress-bg {
  fill: none;
  stroke: #374151;
}

.circular-progress-fill {
  fill: none;
  stroke: #3b82f6;
  stroke-linecap: round;
  transition: stroke-dasharray 0.3s ease;
}

/* تأثيرات البكسلات */
.pixelated {
  image-rendering: -moz-crisp-edges;
  image-rendering: -webkit-crisp-edges;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* تخصيص العلامات */
.badge {
  @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
}

.badge-primary {
  @apply bg-blue-500/20 text-blue-400;
}

.badge-success {
  @apply bg-green-500/20 text-green-400;
}

.badge-warning {
  @apply bg-yellow-500/20 text-yellow-400;
}

.badge-error {
  @apply bg-red-500/20 text-red-400;
}

.badge-gray {
  @apply bg-gray-500/20 text-gray-400;
}

/* تخصيص الأقسام */
.section {
  @apply py-12 px-4;
}

.section-title {
  @apply text-3xl font-bold text-white mb-8;
}

.section-subtitle {
  @apply text-xl text-gray-300 mb-8 max-w-3xl;
}

/* تخصيص الشبكات */
.grid-responsive {
  @apply grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6;
}

/* تأثيرات الظل للنصوص */
.text-shadow-sm {
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

.text-shadow-md {
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.text-shadow-lg {
  text-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
}

/* تخصيص الأيقونات */
.icon-sm {
  @apply w-4 h-4;
}

.icon-md {
  @apply w-6 h-6;
}

.icon-lg {
  @apply w-8 h-8;
}

.icon-xl {
  @apply w-12 h-12;
}

/* تأثيرات التحويم للأيقونات */
.icon-hover {
  @apply transition-transform duration-200 hover:scale-110;
}

/* تخصيص الأزرار ذات الأيقونات */
.btn-icon {
  @apply inline-flex items-center justify-center p-2 rounded-lg transition-all duration-200 hover:bg-gray-700;
}

/* تخصيص القوائم */
.menu-item {
  @apply flex items-center space-x-3 space-x-reverse px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-800 rounded-lg transition-all duration-200;
}

.menu-item.active {
  @apply bg-blue-600 text-white;
}

/* تخصيص الجداول */
.table-container {
  @apply overflow-x-auto rounded-lg border border-gray-700;
}

.table {
  @apply min-w-full divide-y divide-gray-700;
}

.table th {
  @apply px-6 py-3 text-right text-xs font-medium text-gray-400 uppercase tracking-wider bg-gray-800;
}

.table td {
  @apply px-6 py-4 whitespace-nowrap text-sm text-gray-300;
}

.table tr {
  @apply hover:bg-gray-800/50 transition-colors duration-200;
}

/* تخصيص النماذج */
.form-group {
  @apply space-y-2;
}

.form-label {
  @apply block text-sm font-medium text-gray-300;
}

.form-error {
  @apply text-sm text-red-400 mt-1;
}

.form-help {
  @apply text-sm text-gray-400 mt-1;
}

/* تخصيص المحاور */
.tabs {
  @apply flex space-x-1 space-x-reverse;
}

.tab {
  @apply px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200;
}

.tab.inactive {
  @apply text-gray-400 hover:text-white hover:bg-gray-800;
}

.tab.active {
  @apply bg-blue-600 text-white shadow-lg;
}

/* تخصيص التبديل */
.switch {
  @apply relative inline-flex h-6 w-11 items-center rounded-full;
}

.switch input {
  @apply sr-only;
}

.switch-slider {
  @apply inline-block h-4 w-4 transform rounded-full bg-white transition;
}

.switch:has(input:checked) .switch-slider {
  @apply translate-x-5;
}

/* تخصيص التلميحات */
.tooltip {
  @apply absolute z-50 invisible inline-block px-3 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300;
}

.has-tooltip:hover .tooltip {
  @apply visible opacity-100;
}

/* تخصيص القوائم المنسدلة */
.dropdown {
  @apply absolute z-50 mt-2 w-56 rounded-lg shadow-xl bg-gray-800 border border-gray-700 backdrop-blur-sm;
}

.dropdown-item {
  @apply flex items-center space-x-3 space-x-reverse px-4 py-3 text-sm text-gray-300 hover:text-white hover:bg-gray-700 transition-colors duration-200 cursor-pointer;
}

/* تخصيص المودالات */
.modal-overlay {
  @apply fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm;
}

.modal-content {
  @apply bg-gray-800 rounded-2xl border border-gray-700 shadow-2xl max-w-md w-full mx-4;
}

.modal-header {
  @apply flex items-center justify-between p-6 border-b border-gray-700;
}

.modal-body {
  @apply p-6;
}

.modal-footer {
  @apply flex items-center justify-end space-x-3 space-x-reverse p-6 border-t border-gray-700;
}

/* تخصيص الصور الخلفية */
.bg-gradient-radial {
  background-image: radial-gradient(ellipse at center, var(--tw-gradient-stops));
}

.bg-gradient-conic {
  background-image: conic-gradient(from 0deg at 50% 50%, var(--tw-gradient-stops));
}

/* تأثيرات الطبقات */
.layer-1 {
  @apply relative z-10;
}

.layer-2 {
  @apply relative z-20;
}

.layer-3 {
  @apply relative z-30;
}

.layer-modal {
  @apply relative z-50;
}

.layer-toast {
  @apply relative z-60;
}

.layer-tooltip {
  @apply relative z-70;
}

/* تخصيص الرسوم المتحركة */
.animate-bounce-slow {
  animation: bounce 2s infinite;
}

.animate-pulse-slow {
  animation: pulse 3s infinite;
}

.animate-spin-slow {
  animation: spin 3s linear infinite;
}

/* تأثيرات التحويم المتقدمة */
.hover-lift {
  transition: all 0.3s ease;
}

.hover-lift:hover {
  transform: translateY(-8px);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

.hover-glow:hover {
  box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
}

.hover-scale:hover {
  transform: scale(1.05);
}

/* تخصيص شريط التقدم الخطي */
.linear-progress {
  @apply w-full h-2 bg-gray-700 rounded-full overflow-hidden;
}

.linear-progress-fill {
  @apply h-full bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-500 ease-out;
}

/* تخصيص العلامات المائية */
.watermark {
  @apply absolute inset-0 pointer-events-none opacity-5;
  background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M50 50 L100 0 L100 100 L0 100 L0 0 Z' fill='%23ffffff'/%3E%3C/svg%3E");
  background-size: 100px 100px;
}

/* تأثيرات التركيز المحسنة */
.focus-ring:focus {
  @apply outline-none ring-2 ring-blue-500 ring-offset-2 ring-offset-gray-900;
}

/* تخصيص الأزرار المحملة */
.btn-loading {
  @apply relative text-transparent transition-none;
}

.btn-loading::after {
  @apply absolute inset-0 flex items-center justify-center;
  content: '...';
  color: white;
  animation: dots 1.5s steps(4, end) infinite;
}

@keyframes dots {
  0%, 20% { content: '.'; }
  40% { content: '..'; }
  60%, 100% { content: '...'; }
}

/* تخصيص الحدود المتدرجة */
.border-gradient {
  border: 2px solid transparent;
  background: 
    linear-gradient(45deg, #1f2937, #1f2937) padding-box,
    linear-gradient(45deg, #3b82f6, #8b5cf6, #ec4899) border-box;
}

/* تأثيرات الاهتزاز عند الخطأ */
.shake-on-error {
  animation: shake 0.5s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

/* تخصيص الأزرار المستديرة */
.btn-circle {
  @apply rounded-full p-3 transition-all duration-200 hover:scale-110;
}

.btn-circle-sm {
  @apply btn-circle w-10 h-10;
}

.btn-circle-md {
  @apply btn-circle w-12 h-12;
}

.btn-circle-lg {
  @apply btn-circle w-16 h-16;
}

/* تخصيص العناوين الفرعية */
.subheading {
  @apply text-lg text-gray-400 mb-4;
}

/* تخصيص النصوص المساعدة */
.helper-text {
  @apply text-sm text-gray-500;
}

/* تخصيص الرسائل */
.message {
  @apply p-4 rounded-lg border;
}

.message-success {
  @apply message bg-green-900/20 border-green-800 text-green-400;
}

.message-error {
  @apply message bg-red-900/20 border-red-800 text-red-400;
}

.message-warning {
  @apply message bg-yellow-900/20 border-yellow-800 text-yellow-400;
}

.message-info {
  @apply message bg-blue-900/20 border-blue-800 text-blue-400;
}

/* تخصيص الأقسام المطوية */
.collapsible-section {
  @apply border-b border-gray-700 last:border-b-0;
}

.collapsible-header {
  @apply flex items-center justify-between w-full p-4 text-left hover:bg-gray-800/50 transition-colors duration-200 cursor-pointer;
}

.collapsible-content {
  @apply overflow-hidden transition-all duration-300;
}

.collapsible-content.closed {
  @apply max-h-0;
}

.collapsible-content.open {
  @apply max-h-screen;
}

/* تخصيص الأزرار العائمة */
.fab {
  @apply fixed bottom-6 right-6 z-40 w-14 h-14 bg-blue-600 hover:bg-blue-500 rounded-full shadow-lg flex items-center justify-center text-white font-bold text-xl transition-all duration-300 hover:scale-110;
}

.fab-secondary {
  @apply fab bg-gray-700 hover:bg-gray-600;
}

.fab-success {
  @apply fab bg-green-600 hover:bg-green-500;
}

.fab-danger {
  @apply fab bg-red-600 hover:bg-red-500;
}

/* تخصيص شارات الحالة */
.status-badge {
  @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
}

.status-online {
  @apply status-badge bg-green-500/20 text-green-400;
}

.status-offline {
  @apply status-badge bg-gray-500/20 text-gray-400;
}

.status-busy {
  @apply status-badge bg-yellow-500/20 text-yellow-400;
}

.status-error {
  @apply status-badge bg-red-500/20 text-red-400;
}

/* تخصيص الأقسام ذات الخلفيات المتغيرة */
.section-alt {
  @apply bg-gray-800/30 backdrop-blur-sm;
}

.section-highlight {
  @apply bg-gradient-to-r from-blue-600/10 to-purple-600/10;
}

.section-dark {
  @apply bg-gray-900;
}

/* تخصيص الروابط */
.link {
  @apply text-blue-400 hover:text-blue-300 transition-colors duration-200 underline;
}

.link-secondary {
  @apply text-gray-400 hover:text-gray-300 transition-colors duration-200;
}

/* تخصيص الأزرار الكبيرة */
.btn-xl {
  @apply px-8 py-4 text-lg font-semibold rounded-xl;
}

.btn-2xl {
  @apply px-12 py-6 text-xl font-bold rounded-2xl;
}

/* تأثيرات الدخول المتتالية */
.stagger-children > * {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease forwards;
}

.stagger-children > *:nth-child(1) { animation-delay: 0.1s; }
.stagger-children > *:nth-child(2) { animation-delay: 0.2s; }
.stagger-children > *:nth-child(3) { animation-delay: 0.3s; }
.stagger-children > *:nth-child(4) { animation-delay: 0.4s; }
.stagger-children > *:nth-child(5) { animation-delay: 0.5s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* تخصيص الأيقونات المتحركة */
.icon-spin {
  animation: spin 2s linear infinite;
}

.icon-bounce {
  animation: bounce 2s infinite;
}

.icon-pulse {
  animation: pulse 2s infinite;
}

/* تخصيص الخلفيات المخططة */
.bg-stripes {
  background-image: linear-gradient(45deg, rgba(255,255,255,0.1) 25%, transparent 25%, transparent 50%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.1) 75%, transparent 75%, transparent);
  background-size: 10px 10px;
}

/* تخصيص الأزرار المحورة */
.btn-skew {
  transform: skew(-15deg);
}

.btn-skew > span {
  transform: skew(15deg);
  display: inline-block;
}

/* تأثيرات التحويم للصور */
.image-hover {
  transition: all 0.5s ease;
}

.image-hover:hover {
  transform: scale(1.1) rotate(1deg);
}

/* تخصيص العناوين ذات الخطوط المميزة */
.font-display {
  font-family: var(--font-cairo), var(--font-inter), sans-serif;
}

/* تخصيص الأزرار الشفافة */
.btn-glass {
  @apply bg-white/10 backdrop-blur-sm border border-white/20 hover:bg-white/20 transition-all duration-300;
}

/* تخصيص الشعارات */
.logo {
  @apply font-display font-bold text-2xl bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent;
}

.logo-sm {
  @apply logo text-xl;
}

.logo-lg {
  @apply logo text-4xl;
}

.logo-xl {
  @apply logo text-6xl;
}

/* تخصيص الأقسام الكبيرة */
.hero-section {
  @apply min-h-screen flex items-center justify-center relative overflow-hidden;
}

.cta-section {
  @apply py-20 bg-gradient-to-r from-blue-600/10 to-purple-600/10;
}

/* تخصيص الأزرار ذات الظلال الملونة */
.btn-glow {
  box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
  transition: all 0.3s ease;
}

.btn-glow:hover {
  box-shadow: 0 0 30px rgba(59, 130, 246, 0.5);
}

/* تخصيص العناوين الرئيسية */
.main-heading {
  @apply text-4xl md:text-6xl font-bold text-white mb-6;
}

.sub-heading {
  @apply text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl;
}

/* تخصيص الأزرار المميزة */
.btn-featured {
  @apply relative overflow-hidden bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-2xl;
}

.btn-featured::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.btn-featured:hover::before {
  left: 100%;
}

/* تخصيص البطاقات المميزة */
.card-featured {
  @apply relative overflow-hidden bg-gray-800 rounded-2xl border border-gray-700 hover:border-gray-500 transition-all duration-300 transform hover:scale-105 hover:shadow-2xl;
}

.card-featured::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
}

/* تخصيص الأيقونات المميزة */
.icon-featured {
  @apply w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg;
}

/* تخصيص الأقسام المميزة */
.section-featured {
  @apply relative overflow-hidden;
}

.section-featured::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 30% 20%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
              radial-gradient(circle at 70% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

/* تخصيص النصوص المميزة */
.text-featured {
  @apply bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent;
}

/* تخصيص الأزرار ذات التأثيرات الخاصة */
.btn-magic {
  @apply relative overflow-hidden bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg;
}

.btn-magic::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, transparent, rgba(255,255,255,0.3), transparent);
  animation: rotate 3s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* تخصيص العناوين المتحركة */
.animate-typing {
  overflow: hidden;
  border-right: 2px solid;
  white-space: nowrap;
  animation: typing 3s steps(40, end), blink-caret 0.75s step-end infinite;
}

@keyframes typing {
  from { width: 0; }
  to { width: 100%; }
}

@keyframes blink-caret {
  from, to { border-color: transparent; }
  50% { border-color: #3b82f6; }
}

/* تخصيص الأزرار المحملة بشكل جميل */
.btn-loading-beautiful {
  @apply relative overflow-hidden;
}

.btn-loading-beautiful::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: loading-shine 1.5s infinite;
}

@keyframes loading-shine {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* تخصيص البطاقات المتحركة */
.card-animated {
  animation: card-enter 0.6s ease-out;
}

@keyframes card-enter {
  from {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* تخصيص الأيقونات المتحركة */
.icon-animated {
  animation: icon-bounce 2s infinite;
}

@keyframes icon-bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-10px);
  }
  60% {
    transform: translateY(-5px);
  }
}

/* تخصيص الأزرار ذات الظلال المتحركة */
.btn-shadow-animated {
  animation: shadow-pulse 2s infinite;
}

@keyframes shadow-pulse {
  0%, 100% {
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
  }
  50% {
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.8);
  }
}

/* تخصيص النصوص المتلألئة */
.text-shimmer {
  background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899, #3b82f6);
  background-size: 300% 100%;
  animation: shimmer 3s ease infinite;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* تخصيص الخلفيات المتحركة */
.bg-animated {
  animation: gradient-shift 10s ease infinite;
  background-size: 400% 400%;
}

@keyframes gradient-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* تخصيص الأزرار ذات التأثيرات المغناطيسية */
.btn-magnetic {
  transition: all 0.3s ease;
}

.btn-magnetic:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
}

/* تخصيص البطاقات ذات التأثيرات المغناطيسية */
.card-magnetic {
  transition: all 0.3s ease;
}

.card-magnetic:hover {
  transform: translateY(-5px) scale(1.02);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

/* تخصيص الأيقونات المغناطيسية */
.icon-magnetic {
  transition: all 0.3s ease;
}

.icon-magnetic:hover {
  transform: scale(1.2) rotate(5deg);
}

/* تخصيص النصوص المغناطيسية */
.text-magnetic {
  transition: all 0.3s ease;
}

.text-magnetic:hover {
  transform: scale(1.05);
}

/* تخصيص الأزرار ذات التأثيرات اللمسية */
.btn-tactile {
  transition: all 0.1s ease;
}

.btn-tactile:active {
  transform: scale(0.95);
}

/* تخصيص البطاقات ذات التأثيرات اللمسية */
.card-tactile {
  transition: all 0.2s ease;
}

.card-tactile:active {
  transform: scale(0.98);
}

/* تخصيص الأيقونات اللمسية */
.icon-tactile {
  transition: all 0.1s ease;
}

.icon-tactile:active {
  transform: scale(0.9);
}

/* تخصيص النصوص اللمسية */
.text-tactile {
  transition: all 0.1s ease;
}

.text-tactile:active {
  transform: scale(0.95);
}

/* تخصيص الأزرار ذات التأثيرات السائلة */
.btn-liquid {
  position: relative;
  overflow: hidden;
}

.btn-liquid::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.btn-liquid:hover::before {
  left: 100%;
}

/* تخصيص البطاقات السائلة */
.card-liquid {
  position: relative;
  overflow: hidden;
}

.card-liquid::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
  transition: left 0.5s;
}

.card-liquid:hover::before {
  left: 100%;
}

/* تخصيص الأيقونات السائلة */
.icon-liquid {
  position: relative;
  overflow: hidden;
}

.icon-liquid::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.icon-liquid:hover::before {
  left: 100%;
}

/* تخصيص النصوص السائلة */
.text-liquid {
  position: relative;
  overflow: hidden;
}

.text-liquid::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  transition: left 0.5s;
}

.text-liquid:hover::before {
  left: 100%;
}

/* تخصيص الأزرار ذات التأثيرات النيونية */
.btn-neon {
  box-shadow: 0 0 10px rgba(59, 130, 246, 0.5),
              0 0 20px rgba(59, 130, 246, 0.3),
              0 0 30px rgba(59, 130, 246, 0.1);
  transition: all 0.3s ease;
}

.btn-neon:hover {
  box-shadow: 0 0 20px rgba(59, 130, 246, 0.8),
              0 0 30px rgba(59, 130, 246, 0.5),
              0 0 40px rgba(59, 130, 246, 0.2);
}

/* تخصيص البطاقات النيونية */
.card-neon {
  box-shadow: 0 0 15px rgba(59, 130, 246, 0.3),
              0 0 25px rgba(59, 130, 246, 0.2),
              0 0 35px rgba(59, 130, 246, 0.1);
  transition: all 0.3s ease;
}

.card-neon:hover {
  box-shadow: 0 0 25px rgba(59, 130, 246, 0.5),
              0 0 35px rgba(59, 130, 246, 0.3),
              0 0 45px rgba(59, 130, 246, 0.2);
}

/* تخصيص الأيقونات النيونية */
.icon-neon {
  filter: drop-shadow(0 0 5px rgba(59, 130, 246, 0.5))
          drop-shadow(0 0 10px rgba(59, 130, 246, 0.3))
          drop-shadow(0 0 15px rgba(59, 130, 246, 0.1));
  transition: all 0.3s ease;
}

.icon-neon:hover {
  filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.8))
          drop-shadow(0 0 15px rgba(59, 130, 246, 0.5))
          drop-shadow(0 0 20px rgba(59, 130, 246, 0.2));
}

/* تخصيص النصوص النيونية */
.text-neon {
  text-shadow: 0 0 10px rgba(59, 130, 246, 0.5),
               0 0 20px rgba(59, 130, 246, 0.3),
               0 0 30px rgba(59, 130, 246, 0.1);
  transition: all 0.3s ease;
}

.text-neon:hover {
  text-shadow: 0 0 20px rgba(59, 130, 246, 0.8),
               0 0 30px rgba(59, 130, 246, 0.5),
               0 0 40px rgba(59, 130, 246, 0.2);
}

/* تخصيص الأزرار ذات التأثيرات الهولوغرامية */
.btn-hologram {
  background: linear-gradient(45deg, 
    rgba(59, 130, 246, 0.8), 
    rgba(139, 92, 246, 0.8), 
    rgba(236, 72, 153, 0.8), 
    rgba(59, 130, 246, 0.8));
  background-size: 400% 400%;
  animation: hologram 3s ease infinite;
  position: relative;
  overflow: hidden;
}

.btn-hologram::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, 
    transparent 30%, 
    rgba(255,255,255,0.1) 50%, 
    transparent 70%);
  animation: hologram-shine 2s ease infinite;
}

@keyframes hologram {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes hologram-shine {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

/* تخصيص البطاقات الهولوغرامية */
.card-hologram {
  background: linear-gradient(45deg, 
    rgba(59, 130, 246, 0.1), 
    rgba(139, 92, 246, 0.1), 
    rgba(236, 72, 153, 0.1), 
    rgba(59, 130, 246, 0.1));
  background-size: 400% 400%;
  animation: hologram 6s ease infinite;
  position: relative;
  overflow: hidden;
}

.card-hologram::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, 
    transparent 30%, 
    rgba(255,255,255,0.05) 50%, 
    transparent 70%);
  animation: hologram-shine 4s ease infinite;
}

/* تخصيص الأيقونات الهولوغرامية */
.icon-hologram {
  background: linear-gradient(45deg, 
    rgba(59, 130, 246, 0.6), 
    rgba(139, 92, 246, 0.6), 
    rgba(236, 72, 153, 0.6), 
    rgba(59, 130, 246, 0.6));
  background-size: 400% 400%;
  animation: hologram 4s ease infinite;
  position: relative;
  overflow: hidden;
}

.icon-hologram::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, 
    transparent 30%, 
    rgba(255,255,255,0.2) 50%, 
    transparent 70%);
  animation: hologram-shine 3s ease infinite;
}

/* تخصيص النصوص الهولوغرامية */
.text-hologram {
  background: linear-gradient(45deg, 
    #3b82f6, 
    #8b5cf6, 
    #ec4899, 
    #3b82f6);
  background-size: 400% 400%;
  animation: hologram 5s ease infinite;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  position: relative;
}

.text-hologram::before {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, 
    transparent 30%, 
    rgba(255,255,255,0.3) 50%, 
    transparent 70%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: hologram-shine 4s ease infinite;
}

/* تخصيص الأزرار ذات التأثيرات الكهرومغناطيسية */
.btn-electromagnetic {
  background: linear-gradient(45deg, 
    #3b82f6, 
    #8b5cf6, 
    #ec4899);
  background-size: 400% 400%;
  animation: electromagnetic 2s ease infinite;
  position: relative;
  overflow: hidden;
}

.btn-electromagnetic::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.3) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.3) 0%, transparent 50%);
  animation: electromagnetic-pulse 1.5s ease infinite;
}

@keyframes electromagnetic {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes electromagnetic-pulse {
  0%, 100% { opacity: 0; }
  50% { opacity: 1; }
}

/* تخصيص البطاقات الكهرومغناطيسية */
.card-electromagnetic {
  background: linear-gradient(45deg, 
    rgba(59, 130, 246, 0.2), 
    rgba(139, 92, 246, 0.2), 
    rgba(236, 72, 153, 0.2));
  background-size: 400% 400%;
  animation: electromagnetic 4s ease infinite;
  position: relative;
  overflow: hidden;
}

.card-electromagnetic::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.1) 0%, transparent 50%);
  animation: electromagnetic-pulse 3s ease infinite;
}

/* تخصيص الأيقونات الكهرومغناطيسية */
.icon-electromagnetic {
  background: linear-gradient(45deg, 
    rgba(59, 130, 246, 0.8), 
    rgba(139, 92, 246, 0.8), 
    rgba(236, 72, 153, 0.8));
  background-size: 400% 400%;
  animation: electromagnetic 3s ease infinite;
  position: relative;
  overflow: hidden;
}

.icon-electromagnetic::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 40% 40%, rgba(255,255,255,0.3) 0%, transparent 50%),
    radial-gradient(circle at 60% 60%, rgba(255,255,255,0.3) 0%, transparent 50%);
  animation: electromagnetic-pulse 2s ease infinite;
}

/* تخصيص النصوص الكهرومغناطيسية */
.text-electromagnetic {
  background: linear-gradient(45deg, 
    #3b82f6, 
    #8b5cf6, 
    #ec4899, 
    #3b82f6);
  background-size: 400% 400%;
  animation: electromagnetic 5s ease infinite;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  position: relative;
}

.text-electromagnetic::before {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.4) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.4) 0%, transparent 50%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: electromagnetic-pulse 4s ease infinite;
}

/* تخصيص الأزرار ذات التأثيرات الكمومية */
.btn-quantum {
  background: 
    radial-gradient(circle at 30% 20%, rgba(59, 130, 246, 0.8) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(139, 92, 246, 0.8) 0%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.6) 0%, transparent 50%);
  position: relative;
  overflow: hidden;
  animation: quantum-fluctuate 3s ease infinite;
}

.btn-quantum::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 60% 30%, rgba(255,255,255,0.3) 0%, transparent 50%),
    radial-gradient(circle at 40% 70%, rgba(255,255,255,0.3) 0%, transparent 50%);
  animation: quantum-shift 2s ease infinite;
}

@keyframes quantum-fluctuate {
  0%, 100% { 
    background-position: 0% 0%, 100% 100%, 50% 50%;
  }
  33% { 
    background-position: 100% 0%, 0% 100%, 50% 50%;
  }
  66% { 
    background-position: 0% 100%, 100% 0%, 50% 50%;
  }
}

@keyframes quantum-shift {
  0%, 100% { 
    background-position: 60% 30%, 40% 70%;
