/* تخصيص الأزرار ذات التأثيرات الأبعادية */
.btn-dimensional {
  background: 
    linear-gradient(45deg, 
      rgba(59, 130, 246, 0.9) 0%, 
      transparent 50%, 
      rgba(139, 92, 246, 0.9) 100%),
    linear-gradient(135deg, 
      rgba(236, 72, 153, 0.9) 0%, 
      transparent 50%, 
      rgba(59, 130, 246, 0.9) 100%);
  background-size: 200% 200%;
  animation: dimensional-shift 3s ease infinite;
  position: relative;
  overflow: hidden;
  transform-style: preserve-3d;
  perspective: 1000px;
}

.btn-dimensional::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    linear-gradient(45deg, 
      rgba(255,255,255,0.2) 0%, 
      transparent 50%, 
      rgba(255,255,255,0.2) 100%);
  animation: dimensional-glimmer 2s ease infinite;
  transform: translateZ(20px);
}

@keyframes dimensional-shift {
  0%, 100% { background-position: 0% 0%, 100% 100%; }
  50% { background-position: 100% 100%, 0% 0%; }
}

@keyframes dimensional-glimmer {
  0%, 100% { opacity: 0; }
  50% { opacity: 1; }
}

