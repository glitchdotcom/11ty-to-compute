                  onClick={() => setIsOpen(false)}
                >
                  <div className="flex items-center space-x-3">
                    <span>📋</span>
                    <span>لوحة المعاينة الكاملة</span>
                  </div>
                  <span className="opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-0 translate-x-1">
                    🔥
                  </span>
                </Link>
              </div>

              {/* معلومات التطوير */}
              <div className="mt-3 p-3 bg-gray-900 rounded-lg">
                <div className="text-xs text-gray-400 text-center space-y-1">
                  <div>v2.1.0 • Dev Mode • {new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' })}</div>
                  <div className="flex items-center justify-center space-x-2">
                    <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span>جميع الخدمات نشطة</span>
                  </div>
                </div>
              </div>
            </motion.div>

            {/* overlay لإغلاق القائمة */}
